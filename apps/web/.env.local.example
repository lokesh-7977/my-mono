# Copy this file to .env.local and fill in the values.
# apps/web/.env.local is gitignored — never commit real secrets.

# Base URL of the backend API (apps/api)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Must match the GOOGLE_CLIENT_ID used by apps/api so ID tokens verify against the same audience
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Google Maps Embed API key (console.cloud.google.com > APIs & Services > Credentials).
# Used to show a location's map on its /location/{slug} page.
NEXT_PUBLIC_GOOGLE_MAP="your-google-maps-embed-api-key"

# WhatsApp number (digits only, with country code) for the "Chat with Scoutripper on WhatsApp" link
# shown after an enquiry is submitted. Leave unset to open WhatsApp without a chat.
NEXT_PUBLIC_WHATSAPP_NUMBER="your-whatsapp-number-with-country-code"
