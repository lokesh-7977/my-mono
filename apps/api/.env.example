# Copy this file to .env and fill in the values before running the API.
# apps/api/.env is gitignored — never commit real secrets.

# --- Database (MongoDB via Prisma) ---
# Full Prisma connection string. packages/database reads this (via its own .env)
# when generating the client or running migrations.
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority"

# --- JWT ---
# Signing algorithm used for access/refresh tokens, e.g. HS256
ALG="HS256"
# Random secret, at least 32 characters long
JWT_ACCESS_SECRET="replace-with-a-random-32+-character-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-32+-character-secret"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# --- Google OAuth ---
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# --- Runtime ---
NODE_ENV="development"
LOG_LEVEL="info"
# Origin allowed to call this API with credentials (must match apps/web's dev URL)
WEB_ORIGIN="http://localhost:3002"
