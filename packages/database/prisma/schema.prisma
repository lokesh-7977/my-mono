generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
 
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DELETED
  SUSPENDED
}

enum TrekLevel {
  GUIDE
  LEADER
  MOUNTAINEER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TrekStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

model User {
  id        String @id @map("_id")
  googleId  String @unique
  email     String @unique
  name      String?
  avatarUrl String?

  role      UserRole   @default(USER)
  status    UserStatus @default(ACTIVE)
  isDeleted Boolean    @default(false)

  trekLevel       TrekLevel @default(GUIDE)
  experienceYears Int       @default(0)
  phone           String?
  bio             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions           Session[]
  userExperiences    UserExperience[]
  userCertifications UserCertification[]
  userBadges         UserBadge[]
  masterTreks        MasterTrek[]
}

model Session {
  id               String @id @map("_id")
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  ipAddress        String?
  userAgent        String?
  isRevoked        Boolean @default(false)

  user User @relation(fields: [userId],references: [id], onDelete: Cascade)
}

model UserExperience {
  id     String @id @map("_id")
  userId String

  trekName           String
  difficulty         Difficulty
  roleDuringTrek     String
  completedAt        DateTime
  duration           Int
  altitude           Float?
  proofUrl           String?
  verificationStatus String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
}

model UserCertification {
  id     String @id @map("_id")
  userId String

  title               String
  issuingOrganization String
  certificateNumber   String?
  certificateUrl      String
  issuedAt            DateTime
  expiresAt           DateTime?
  verificationStatus  String
  verifiedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
}

model Badge {
  id          String @id @map("_id")
  name        String @unique
  description String
  iconUrl     String?
  criteria    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @map("_id")
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}



model MasterTrek {
  id String @id @map("_id")

  name             String
  slug             String  @unique
  shortDescription String?
  description      String
  tagline          String?

  difficulty     Difficulty
  durationDays   Int
  maxAltitude    Float?
  distanceKm     Float?
  distinctRoutes Int @default(1)

  baseLocation String
  state        String
  country      String @default("India")
  latitude     Float?
  longitude    Float?

  bestSeason       String?
  beginnerFriendly Boolean @default(false)

  overview           String?
  howToReach         String?
  fitnessInfo        String?
  safetyInfo         String?
  permitInfo         String?
  sustainabilityInfo String?

  coverImageUrl String?
  videoUrl      String?
  galleryImages String[]

  status TrekStatus @default(DRAFT)

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  routes       TrekRoute[]
  nearbyPlaces TrekNearbyPlace[]

  activityIds String[]
  activities  Activity[] @relation(fields: [activityIds], references: [id])
}

model TrekRoute {
  id           String @id @map("_id")
  masterTrekId String

  name        String
  description String?

  distanceKm    Float?
  difficulty    Difficulty?
  elevationGain Float?
  ascentTime    String?
  descentTime   String?

  startPoint String?
  endPoint   String?

  isPopular Boolean @default(false)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  masterTrek    MasterTrek         @relation(fields: [masterTrekId], references: [id], onDelete: Cascade)
  itineraryDays TrekItineraryDay[]
}

model TrekItineraryDay {
  id      String @id @map("_id")
  routeId String

  dayNumber   Int
  title       String
  description String?

  startLocation String?
  endLocation   String?

  distanceKm Float?
  duration   String?
  altitude   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route TrekRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  activityIds String[]
  activities  Activity[] @relation(fields: [activityIds], references: [id])
}

model Activity {
  id          String @id @map("_id")
  name        String @unique
  description String?
  iconUrl     String?

  trekIds String[]
  treks   MasterTrek[] @relation(fields: [trekIds], references: [id])

  itineraryDayIds String[]
  itineraryDays   TrekItineraryDay[] @relation(fields: [itineraryDayIds], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NearbyPlace {
  id String @id @map("_id")

  name        String
  description String?
  location    String?
  latitude    Float?
  longitude   Float?
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trekLinks TrekNearbyPlace[]
}

model TrekNearbyPlace {
  id String @id @map("_id")

  trekId        String
  nearbyPlaceId String

  distanceFromTrek Float?
  travelTime       String?

  trek        MasterTrek  @relation(fields: [trekId], references: [id], onDelete: Cascade)
  nearbyPlace NearbyPlace @relation(fields: [nearbyPlaceId], references: [id], onDelete: Cascade)

  @@unique([trekId, nearbyPlaceId])
}
