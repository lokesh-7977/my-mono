# Copy this file to .env and fill in the value before running Prisma CLI
# commands (generate, migrate, studio) directly from this package.
# packages/database/.env is gitignored — never commit real secrets.
# This must match the DATABASE_URL used by apps/api/.env.

DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority"
